RC_ENV=development
RC_HTTP_ADDR=:8080
RC_DATABASE_URL=postgres://rc:rc@localhost:5432/rc?sslmode=disable
RC_API_TOKEN=replace-me
# Development-only example. Generate a production key with: openssl rand -base64 32
RC_HEADER_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
RC_LOG_LEVEL=debug
RC_LOG_FORMAT=console
RC_WORKER_CONCURRENCY=4
RC_DELIVERY_TIMEOUT=5s
RC_POLL_INTERVAL=500ms
RC_LEASE_DURATION=30s
RC_MAX_ATTEMPTS=10
RC_BASE_BACKOFF=5s
RC_MAX_BACKOFF=15m
